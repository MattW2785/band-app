# Crea un progetto su https://supabase.com, poi copia questo file in .env.local
# e incolla i valori da Project Settings > API.

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Solo server-side: usata per invitare i membri via supabase.auth.admin.inviteUserByEmail.
# NON esporre mai al client, non deve avere il prefisso NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Crea un account su https://resend.com per abilitare le notifiche email (Modulo 7).
# Senza dominio verificato, il piano sandbox invia solo all'email con cui ti sei registrato:
# per notificare tutti i membri della band serve verificare un dominio proprio su Resend.
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=BandSpace <onboarding@resend.dev>

# URL pubblico dove gira l'app, usato per i link nelle email di invito.
# In locale: http://localhost:3000. In produzione: l'URL del dominio Vercel (o il tuo dominio personalizzato).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Modulo Social (pubblicazione automatica YouTube/Instagram) ---

# Connessione Postgres per Prisma: recupera entrambe da Supabase Dashboard
# > Project Settings > Database > Connect > tab "ORM" > Prisma.
# DATABASE_URL è la connessione pooled (porta 6543), usata a runtime dall'app.
DATABASE_URL=postgresql://postgres.xxxxxxxxxxxx:password@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true
# DIRECT_URL è la connessione diretta (porta 5432), usata solo da `prisma migrate`.
DIRECT_URL=postgresql://postgres.xxxxxxxxxxxx:password@aws-0-eu-central-1.pooler.supabase.com:5432/postgres

# Cloudflare R2 (storage media per i post social, upload diretto dal browser).
# Crea un bucket su https://dash.cloudflare.com > R2.
R2_ACCOUNT_ID=...
R2_ACCESS_KEY_ID=...
R2_SECRET_ACCESS_KEY=...
R2_BUCKET_NAME=...
R2_PUBLIC_URL=https://...

# Chiave AES-256-GCM (32 byte esadecimali = 64 caratteri) usata per cifrare i token
# OAuth di YouTube/Instagram salvati su DB. Generala con: openssl rand -hex 32
ENCRYPTION_KEY=...

# Token condiviso che i cron esterni (es. cron-job.org) devono passare come
# "Authorization: Bearer <CRON_SECRET>" per chiamare /api/cron/publish e /api/cron/refresh-tokens.
CRON_SECRET=...

# Fuso orario usato per interpretare gli orari di pubblicazione nel calendario editoriale.
APP_TIMEZONE=Europe/Rome

# Credenziali OAuth Google (YouTube Data API) — Google Cloud Console > Credenziali.
GOOGLE_CLIENT_ID=...
GOOGLE_CLIENT_SECRET=...

# Credenziali OAuth Meta (Instagram API with Instagram Login) — Meta for Developers.
INSTAGRAM_APP_ID=...
INSTAGRAM_APP_SECRET=...
